# Template for .env, which is created from this file automatically on first open
# (Dev Container or ./scripts/up.sh). Paste your key into .env, never here:
# .env is gitignored, this file is not.
ANTHROPIC_API_KEY=
# Optional, for the other pilots in config/pilots.yaml:
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Versions (PX4 v1.17.0, px4_msgs release/1.17, the AAS commit) are pinned in
# docker/Dockerfile and the external/aerial-autonomy-stack submodule, not here,
# and recorded in every episode's meta.json.
