+void PX4Offboard::traj_ref_avians(OffboardControlMode& mode)
+{
+    constexpr double YAW_FROM_SPEED_MS = 1.0; // m/s, face the direction of travel above this horizontal speed
+
+    if (vehicle_type_ != 1) { // Publish nothing if the vehicle is not ROTARY_WING
+        RCLCPP_WARN(get_logger(), "This controller is only for multicopters");
+        return;
+    }
+    mode.position = true;
+    mode.velocity = true; // Velocity (and acceleration) feedforward
+    TrajectorySetpoint trajectory_ref; // https://github.com/PX4/px4_msgs/blob/release/1.17/msg/TrajectorySetpoint.msg
+    trajectory_ref.timestamp = mode.timestamp;
+    trajectory_ref.jerk = {NAN, NAN, NAN}; // Unused
+    trajectory_ref.yawspeed = NAN;         // Unused, the absolute yaw does the steering
+    if (std::isnan(avians_yaw_)) { avians_yaw_ = heading_; }
+
+    const size_t n = avians_traj_.size() / AVIANS_SAMPLE_SIZE;
+    if (n == 0) { // No trajectory yet: hold where the vehicle was when this controller started
+        if (std::isnan(avians_hold_[0])) { avians_hold_ = {x_, y_, z_, heading_}; }
+        trajectory_ref.position = {static_cast<float>(avians_hold_[0]), static_cast<float>(avians_hold_[1]), static_cast<float>(avians_hold_[2])};
+        trajectory_ref.velocity = {0.0, 0.0, 0.0};
+        trajectory_ref.acceleration = {NAN, NAN, NAN};
+        trajectory_ref.yaw = static_cast<float>(avians_hold_[3]);
+        publish_ref(trajectory_ref);
+        return;
+    }
+    const double *d = avians_traj_.data();
+    auto sample_t = [d](size_t k) { return d[k * AVIANS_SAMPLE_SIZE]; };
+    double t = (this->get_clock()->now() - avians_traj_t0_).seconds();
+    std::array<double, 3> pos, vel, acc = {0.0, 0.0, 0.0};
+    if (n == 1 || t >= sample_t(n - 1)) { // Past the end: hold the last point
+        const double *s = d + ((n - 1) * AVIANS_SAMPLE_SIZE);
+        pos = {s[1], s[2], s[3]};
+        vel = {0.0, 0.0, 0.0};
+    } else {
+        t = std::max(t, sample_t(0));
+        size_t lo = 0, hi = n - 1; // Binary search for sample_t(lo) <= t < sample_t(hi), with hi == lo + 1
+        while (hi - lo > 1) {
+            size_t mid = (lo + hi) / 2;
+            if (sample_t(mid) <= t) { lo = mid; } else { hi = mid; }
+        }
+        const double *a = d + (lo * AVIANS_SAMPLE_SIZE), *b = d + (hi * AVIANS_SAMPLE_SIZE);
+        double dt = std::max(1e-6, b[0] - a[0]);
+        double u = std::clamp((t - a[0]) / dt, 0.0, 1.0);
+        for (int i = 0; i < 3; i++) {
+            pos[i] = a[1 + i] + (u * (b[1 + i] - a[1 + i]));
+            vel[i] = a[4 + i] + (u * (b[4 + i] - a[4 + i]));
+            acc[i] = (b[4 + i] - a[4 + i]) / dt;
+        }
+    }
+    if (std::hypot(vel[0], vel[1]) > YAW_FROM_SPEED_MS) { avians_yaw_ = std::atan2(vel[1], vel[0]); } // NED yaw of the velocity, in [-PI:PI]
+    trajectory_ref.position = {static_cast<float>(pos[0]), static_cast<float>(pos[1]), static_cast<float>(pos[2])};
+    trajectory_ref.velocity = {static_cast<float>(vel[0]), static_cast<float>(vel[1]), static_cast<float>(vel[2])};
+    trajectory_ref.acceleration = {static_cast<float>(acc[0]), static_cast<float>(acc[1]), static_cast<float>(acc[2])};
+    trajectory_ref.yaw = static_cast<float>(avians_yaw_);
+    publish_ref(trajectory_ref);
+}
