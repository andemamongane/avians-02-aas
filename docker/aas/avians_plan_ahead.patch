+void PX4Offboard::avians_trajectory_callback(const std_msgs::msg::Float64MultiArray::SharedPtr msg)
+{
+    std::unique_lock<std::shared_mutex> lock(node_data_mutex_); // Use unique_lock for data writes
+    if (msg->data.size() < AVIANS_SAMPLE_SIZE || (msg->data.size() % AVIANS_SAMPLE_SIZE) != 0) {
+        RCLCPP_WARN(get_logger(), "avians trajectory ignored: %zu values is not a whole number of samples", msg->data.size());
+        return;
+    }
+    avians_traj_ = msg->data; // A new trajectory replaces the reference, timed from now
+    avians_traj_t0_ = this->get_clock()->now();
+}
