{
  "name": "avians-02-aas",
  "initializeCommand": {
    "env": "test -f .env || cp .env.example .env",
    "image": ["docker", "compose", "-f", "docker/compose.yml", "build"]
  },
  "dockerComposeFile": ["../docker/compose.yml", "compose.devcontainer.yml"],
  "service": "avians",
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-iot.vscode-ros"],
      "settings": { "python.defaultInterpreterPath": "/usr/bin/python3" }
    }
  }
}
